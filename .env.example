# ── Mailer gateway configuration ──────────────────────────────────────────
# Copy to .env for local runs. In production these come from docker-compose env.

MAILER_PORT=8025
NODE_ENV=production

# Per-product API keys: "app:key" pairs, comma-separated. Each product sends its
# key as X-Api-Key; the key identifies the tenant (app). Generate long random keys.
MAILER_API_KEYS=trustlist:CHANGE_ME_trustlist_key,rutba:CHANGE_ME_rutba_key
# Apps allowed to do global suppression + cross-tenant reads.
MAILER_ADMIN_APPS=trustlist

# Public base URL of THIS gateway (for unsubscribe + open-pixel links).
MAILER_PUBLIC_URL=https://mail-gw.trustlist.uk

# ── Own MySQL database (separate from app DBs) ─────────────────────────────
MAILER_DB_HOST=mysql
MAILER_DB_PORT=3306
MAILER_DB_NAME=trustlist_mailer
MAILER_DB_USER=mailer
MAILER_DB_PASSWORD=CHANGE_ME
MAILER_DB_POOL=10

# ── Outbound SMTP (Mailcow) ────────────────────────────────────────────────
SMTP_HOST=mail.trustlist.uk
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=no-reply@trustlist.uk
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=no-reply@trustlist.uk
SMTP_REPLY_TO=contact@trustlist.uk
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=5
SMTP_MAX_MESSAGES=100

# ── Send worker (drip/bleed pacing) ────────────────────────────────────────
MAILER_WORKER_ENABLED=true
MAILER_WORKER_TICK_MS=1000
MAILER_WORKER_BATCH=50
MAILER_GLOBAL_INFLIGHT=20
MAILER_DOMAIN_INFLIGHT=5
MAILER_DOMAIN_MIN_INTERVAL_MS=0

# ── Bounce capture (IMAP poller of the VERP / return-path mailbox) ─────────
MAILER_BOUNCE_ENABLED=false
MAILER_BOUNCE_DOMAIN=bounce.trustlist.uk
MAILER_BOUNCE_MAILBOX=INBOX
MAILER_BOUNCE_POLL_MS=60000
MAILER_BOUNCE_IMAP_HOST=mail.trustlist.uk
MAILER_BOUNCE_IMAP_PORT=993
MAILER_BOUNCE_IMAP_SECURE=true
MAILER_BOUNCE_IMAP_USER=bounces@trustlist.uk
MAILER_BOUNCE_IMAP_PASS=CHANGE_ME
