# ── Rutba MTA configuration ──────────────────────────────────────────────
# Copy to .env for local runs. In production set these on the running
# container/host; never commit secrets.

MAILER_PORT=8025
NODE_ENV=production

# Public base URL of THIS service (must be reachable by email recipients —
# used to build action and unsubscribe links). REQUIRED in production.
MAILER_PUBLIC_URL=https://mta.example.com

# ── Secrets (REQUIRED in production) ─────────────────────────────────────
# HMAC secret for signing action / unsubscribe tokens.
#   Generate: openssl rand -hex 32
MAILER_HMAC_SECRET=CHANGE_ME_long_random_value
# AES-256 key for encrypting stored SMTP passwords at rest.
#   64 hex chars used directly; anything else is SHA-256-hashed to a key.
#   Generate: openssl rand -hex 32
MAILER_SMTP_ENC_KEY=CHANGE_ME_long_random_value

# ── Own MySQL database ───────────────────────────────────────────────────
# The database name is configurable. `mailers` is the recommended default;
# pick another (and create it) if you prefer.
MAILER_DB_HOST=mysql
MAILER_DB_PORT=3306
MAILER_DB_NAME=mailers
MAILER_DB_USER=mailer
MAILER_DB_PASSWORD=CHANGE_ME
MAILER_DB_POOL=10

# ── Send worker (adaptive reputation pacing) ─────────────────────────────
MAILER_WORKER_ENABLED=true
MAILER_WORKER_TICK_MS=1000
MAILER_WORKER_BATCH=50
MAILER_GLOBAL_INFLIGHT=20
MAILER_DOMAIN_INFLIGHT=5
# Fallback per-domain hard ceiling (messages/minute) when no override is set.
MAILER_DOMAIN_MAX_PER_MIN=600
# Minimum sends to a domain before its reputation score is trusted.
MAILER_WARMUP_MIN=20

# ── Webhook delivery worker ──────────────────────────────────────────────
MAILER_WEBHOOK_TIMEOUT_MS=10000
MAILER_WEBHOOK_MAX_ATTEMPTS=6
MAILER_WEBHOOK_TICK_MS=5000

# ── Action defaults ──────────────────────────────────────────────────────
MAILER_ACTION_EXPIRY_HOURS=72

# ── Bounce capture (IMAP poller of the VERP / return-path mailbox) ───────
MAILER_BOUNCE_ENABLED=false
MAILER_BOUNCE_DOMAIN=bounce.example.com
MAILER_BOUNCE_MAILBOX=INBOX
MAILER_BOUNCE_POLL_MS=60000
MAILER_BOUNCE_IMAP_HOST=mail.example.com
MAILER_BOUNCE_IMAP_PORT=993
MAILER_BOUNCE_IMAP_SECURE=true
MAILER_BOUNCE_IMAP_USER=bounces@example.com
MAILER_BOUNCE_IMAP_PASS=CHANGE_ME
